From: RetroArch-PI
Subject: [PATCH] screenshot on SIGUSR1; audio level in the speed log

For automated game tests (scripts/game-test.sh):

- runloop: SIGUSR1 sets a flag; the next runloop iteration takes a
  screenshot exactly as the "take screenshot" hotkey does (the rendered
  frame, read back from the GPU with shaders applied). The test's virtual
  pad holds buttons while it plays, so pressing the PS-modifier hotkey for
  a screenshot would disturb the game.
- audio: the RETROARCH_LOG_SPEED line (patch 0007) also reports the RMS
  and peak level of what the core produced in that window, before the
  volume control, so a test can tell sound from silence.

---
--- a/audio/audio_driver.c
+++ b/audio/audio_driver.c
@@ -824,14 +824,23 @@
  *   [Audio]: Speed:  98.7% (core audio 4.94 s in 5.00 s wall)
  * A window during which the menu was open or the core produced no audio
  * reads low; ignore those.
+ *
+ * RetroArch-PI (patch 0009): the same line also gives the level of what the
+ * core produced in that window, before the volume control, so a test can
+ * tell real sound from silence:
+ *   [Audio]: Speed:  98.7% (core audio 4.94 s in 5.00 s wall) level rms -21.4 peak -3.1 dBFS
+ * Digital silence reads -inf (printed as -99.0).
  */
-static void audio_driver_log_speed(size_t frames)
+static void audio_driver_log_speed(const int16_t *data, size_t frames)
 {
    static int      enabled = -1;
    static retro_time_t t0;
    static uint64_t acc;
    static unsigned since_check;
+   static double   sumsq;
+   static int      peak;
    retro_time_t    now;
+   size_t          i;
 
    if (enabled < 0)
    {
@@ -841,6 +850,14 @@
    if (!enabled)
       return;
 
+   for (i = 0; i < frames * 2; i++)      /* interleaved stereo */
+   {
+      int s = data[i] < 0 ? -(int)data[i] : data[i];
+      sumsq += (double)data[i] * (double)data[i];
+      if (s > peak)
+         peak = s;
+   }
+
    acc         += frames;
    since_check += (unsigned)frames;
    if (since_check < 1024)      /* read the clock ~every 20 ms, not per sample */
@@ -852,11 +869,17 @@
    {
       double rate = video_state_get_ptr()->av_info.timing.sample_rate;
       double wall = (double)(now - t0) / 1000000.0;
+      double rms  = acc ? sqrt(sumsq / (double)(acc * 2)) : 0.0;
+      double rmsd = rms  > 0.0 ? 20.0 * log10(rms / 32768.0) : -99.0;
+      double pkd  = peak > 0   ? 20.0 * log10((double)peak / 32768.0) : -99.0;
       if (rate > 0.0)
-         RARCH_LOG("[Audio]: Speed: %5.1f%% (core audio %.2f s in %.2f s wall)\n",
-               100.0 * (double)acc / rate / wall, (double)acc / rate, wall);
-      acc = 0;
-      t0  = now;
+         RARCH_LOG("[Audio]: Speed: %5.1f%% (core audio %.2f s in %.2f s wall) level rms %.1f peak %.1f dBFS\n",
+               100.0 * (double)acc / rate / wall, (double)acc / rate, wall,
+               rmsd < -99.0 ? -99.0 : rmsd, pkd);
+      acc   = 0;
+      sumsq = 0.0;
+      peak  = 0;
+      t0    = now;
    }
 }
 
@@ -867,7 +890,12 @@
    recording_state_t *recording_st = NULL;
    if (audio_st->flags & AUDIO_FLAG_SUSPENDED)
       return;
-   audio_driver_log_speed(1);
+   {
+      int16_t lr[2];
+      lr[0] = left;
