--- a/runloop.c
+++ b/runloop.c
@@ -6827,6 +6827,48 @@
  * button input in order to wake up the loop,
  * -1 if we forcibly quit out of the RetroArch iteration loop.
  **/
+/*
+ * Screenshot on SIGUSR1 (RetroArch-PI, for automated game tests).
+ *
+ * `kill -USR1 <retroarch pid>` makes the next runloop iteration take a
+ * screenshot exactly as the "take screenshot" hotkey does: the rendered frame,
+ * read back from the GPU with shaders applied, saved as a PNG in
+ * screenshot_directory. A test needs this while its virtual pad is holding
+ * buttons, when pressing the PS modifier for the hotkey would disturb the
+ * game. The handler only sets a flag; the work happens on the main thread.
+ */
+#if (defined(__linux__) || defined(__unix__)) && !defined(EMSCRIPTEN)
+static volatile sig_atomic_t retroopi_screenshot_requested = 0;
+
+static void retroopi_sigusr1(int sig)
+{
+   (void)sig;
+   retroopi_screenshot_requested = 1;
+}
+
+static void retroopi_take_requested_screenshot(void)
+{
+   static bool installed = false;
+   if (!installed)
+   {
+      struct sigaction sa;
+      memset(&sa, 0, sizeof(sa));
+      sa.sa_handler = retroopi_sigusr1;
+      sigemptyset(&sa.sa_mask);
+      sa.sa_flags   = SA_RESTART;
+      sigaction(SIGUSR1, &sa, NULL);
+      installed     = true;
+   }
+   if (retroopi_screenshot_requested)
+   {
+      retroopi_screenshot_requested = 0;
+      command_event(CMD_EVENT_TAKE_SCREENSHOT, NULL);
+   }
+}
+#else
+static void retroopi_take_requested_screenshot(void) { }
+#endif
+
 int runloop_iterate(void)
 {
    int i;
@@ -6864,7 +6906,11 @@
    bool audio_sync                              = settings->bools.audio_sync;
 #ifdef HAVE_DISCORD
    discord_state_t *discord_st                  = discord_state_get_ptr();
+#endif
+
+   retroopi_take_requested_screenshot();
 
+#ifdef HAVE_DISCORD
    if (discord_st->inited)
    {
       Discord_RunCallbacks();
