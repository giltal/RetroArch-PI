# RetroArch-PI -- Retroflag GPi Case 2 + Compute Module 4 Lite (BCM2711, 4x
# Cortex-A72, V3D 4.2)
#
# rpi4_retro_defconfig with the board lines changed (the same SoC, kernel and
# userspace; plan: docs/boards/gpicase2.md). That file was generated from
# opi_zero3_retro_defconfig: the userspace -- launcher,
# RetroArch, cores, init scripts, DS3 Bluetooth -- is the same, and so is
# every shared section of this file. The board layer (arch, kernel, firmware
# boot, Mesa driver) is modelled on Buildroot's own
# configs/raspberrypi4_64_defconfig.
#
# Output: HDMI at 1920x1080. See RETROOPI_LAUNCHER_SCREEN_W/H below and
# video_fullscreen_x/y in retroarch.cfg. They must agree (post-build.sh checks).

# --- Architecture -------------------------------------------------------
# AArch64, as on the H616 boards: the cores that matter have AArch64
# dynarecs (pcsx_rearmed, gpSP, parallel-n64, PPSSPP, Flycast). Cortex-A72
# tuning; a separate toolchain from the A53 boards' (own work directory).
BR2_aarch64=y
BR2_cortex_a72=y
BR2_ARM_FPU_VFPV4=y

# --- Toolchain ----------------------------------------------------------
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# --- System -------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="retroopi"
BR2_TARGET_GENERIC_ISSUE="RetroArch-PI (GPi Case 2, CM4)"
# No serial console: GPIO14/15 are LCD data lines in this case, so
# config.txt has enable_uart=0 and there is no ttyS0. A getty on it made init
# respawn it forever, filling tty1 with "can't open /dev/ttyS0" (first boot,
# 2026-10-28). Log in over SSH.
# BR2_TARGET_GENERIC_GETTY is not set
# dropbear refuses root login with an empty password. Development credential,
# same convention as the reference -- change before this ships.
BR2_TARGET_GENERIC_ROOT_PASSWD="retroopi"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RETROOPI_PATH)/board/common/rootfs_overlay $(BR2_EXTERNAL_RETROOPI_PATH)/board/bcm2711/rootfs_overlay"
# Post-build: the shared checks, then the BCM2711 boot-chain checks. Post-image:
# two scripts, run in order: ours builds the exFAT ROM partition
# image, then the stock wrapper assembles sdcard.img from genimage.cfg
# (boot FAT, rootfs, /data, ROMs).
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RETROOPI_PATH)/board/common/post-build.sh $(BR2_EXTERNAL_RETROOPI_PATH)/board/bcm2711/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RETROOPI_PATH)/board/common/post-image.sh support/scripts/genimage.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(BR2_EXTERNAL_RETROOPI_PATH)/board/gpicase2/genimage.cfg"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RETROOPI_PATH)/board/common/patches $(BR2_EXTERNAL_RETROOPI_PATH)/board/bcm2711/patches"

# --- Kernel -------------------------------------------------------------
# The Raspberry Pi kernel (user's decision, docs/boards/rpi4.md): the
# firmware's DT overlays are written for it. rpi-6.18.y, the same 6.18 series
# as the H616 boards, pinned to one commit (6.18.57). Buildroot itself pins
# rpi-6.12.y; the hash is in board/bcm2711/patches/linux/linux.hash.
# The kernel is NOT installed into the rootfs: the firmware loads it from the
# boot partition (p1), and only genimage puts it there.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,234188315037848e5b07d65b85d38edc64095caa)/linux-234188315037848e5b07d65b85d38edc64095caa.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
# Image.gz: the firmware reads ~10 MB off the card instead of the 29 MB Image,
# and unpacks it itself (it handles gzip; the H616 boards do the same with LZ4
# through U-Boot).
BR2_LINUX_KERNEL_IMAGEGZ=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RETROOPI_PATH)/board/common/linux-retrogaming.config $(BR2_EXTERNAL_RETROOPI_PATH)/board/bcm2711/linux-retrogaming.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-cm4"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- Boot: VideoCore firmware ------------------------------------------
# No TF-A, no U-Boot: the EEPROM bootloader starts start4.elf from the FAT boot
# partition, which reads config.txt and cmdline.txt and starts the kernel.
# DT overlays come prebuilt with the firmware (Buildroot's tested path); the
# base DTB is built from the kernel, with symbols (-@) so overlays apply.
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_RETROOPI_PATH)/board/gpicase2/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_RETROOPI_PATH)/board/gpicase2/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y

# --- Filesystem ---------------------------------------------------------
# 1 GB rather than the reference's 512M: arm64 defconfig ships a large module
# tree, and the AArch64 cores are bigger.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1024M"
# BR2_TARGET_ROOTFS_TAR is not set

# --- Bring-up toolkit ---------------------------------------------------
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_DTC=y
BR2_PACKAGE_DTC_PROGRAMS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
# dosfstools installs NOTHING without this sub-option. The reference shipped
# without fsck.fat for weeks and could not clear a stale FAT dirty flag.
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
# The ROM partition is exFAT as built (post-image.sh): fsck.exfat to match.
BR2_PACKAGE_EXFATPROGS=y

# --- Mesa/v3d: GPU acceleration -----------------------------------------
# V3D 4.2 renders (GLES 3.1), vc4 scans out: the same split as panfrost +
# sun4i-drm on the H616 boards, paired by Mesa's kmsro. GBM needs a
# per-display vc4_dri.so stub for that, which Mesa only builds with GLX/X11
# unless patches/mesa3d/0001 is applied. Without it:
# "[KMS]: Couldn't create GBM device".
#
# No LLVM here: only panfrost needs it (its precompiled OpenCL C shader
# library). v3d and vc4 compile their shaders with NIR alone, which saves the
# LLVM + clang build (~1 h) and the 65 MB libLLVM on the target.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# --- Launcher -----------------------------------------------------------
# Pulls in SDL2 / SDL2_ttf / SDL2_image / freetype / libdrm. SDL2 is used only
# for TTF/PNG surfaces; the launcher does its own KMS.
BR2_PACKAGE_RETROOPI_LAUNCHER=y
# Symbol fallback font for the launcher. launcher.ttf has no symbols (gear,
# star, clock, arrows, PS buttons), which all showed as "missing glyph" boxes.
# Sans only (~750 KB). The other DejaVu faces default to y, so turn them off.
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_SANS=y
# BR2_PACKAGE_DEJAVU_MONO is not set
# BR2_PACKAGE_DEJAVU_SERIF is not set
# BR2_PACKAGE_DEJAVU_SANS_CONDENSED is not set
# BR2_PACKAGE_DEJAVU_SERIF_CONDENSED is not set
# HDMI mode the launcher asks the TV for. It is also the size of the launcher's
# framebuffer, so it must be a mode the TV offers. 1920x1080@60 is what
# essentially every TV offers. 1280x720@60 is the fallback (CEA-mandatory for
# every HDMI sink). Must match video_fullscreen_x/y in retroarch.cfg;
# post-build.sh fails the build if they differ.
BR2_PACKAGE_RETROOPI_LAUNCHER_SCREEN_W=1920
BR2_PACKAGE_RETROOPI_LAUNCHER_SCREEN_H=1080

# --- RetroArch ----------------------------------------------------------
BR2_PACKAGE_RETROARCH=y
BR2_PACKAGE_RETROARCH_RGUI=y
BR2_PACKAGE_RETROARCH_ASSETS=y
# BR2_PACKAGE_RETROARCH_NETWORKING is not set
# BR2_PACKAGE_RETROARCH_HID is not set

# --- libretro cores -----------------------------------------------------
# The reference's shipped set: 21 cores, every one verified at full speed on a
# 1.2 GHz Cortex-A7. The A53 at 1.5 GHz is faster per clock and runs
# AArch64 builds, so this is the known-good baseline. Heavier or
# GPU-dependent cores come after this boots and is measured.
#
# Nintendo
BR2_PACKAGE_LIBRETRO_FCEUMM=y
BR2_PACKAGE_LIBRETRO_NESTOPIA=y
BR2_PACKAGE_LIBRETRO_QUICKNES=y
BR2_PACKAGE_LIBRETRO_GAMBATTE=y
BR2_PACKAGE_LIBRETRO_TGBDUAL=y
BR2_PACKAGE_LIBRETRO_MGBA=y
BR2_PACKAGE_LIBRETRO_SNES9X2005=y
BR2_PACKAGE_LIBRETRO_SNES9X2010=y
# Sega
BR2_PACKAGE_LIBRETRO_GENESISPLUSGX=y
# Atari
BR2_PACKAGE_LIBRETRO_STELLA2023=y
BR2_PACKAGE_LIBRETRO_PROSYSTEM=y
BR2_PACKAGE_LIBRETRO_ATARI800=y
# NEC
BR2_PACKAGE_LIBRETRO_BEETLEPCEFAST=y
BR2_PACKAGE_LIBRETRO_BEETLESUPERGRAFX=y
# Arcade
BR2_PACKAGE_LIBRETRO_FBALPHA2012=y
BR2_PACKAGE_LIBRETRO_MAME2003PLUS=y
# Home computers / DOS
BR2_PACKAGE_LIBRETRO_FUSE=y
BR2_PACKAGE_LIBRETRO_PRBOOM=y
# PlayStation: pcsx_rearmed, NEON/AArch64 dynarec. Needs a BIOS in
# /opt/roms/_system/bios -- see system_directory in retroarch.cfg.
BR2_PACKAGE_LIBRETRO_PCSX=y
# Nintendo 64: parallel-n64, the reference's tuned core. It carries the audio
# patches 0002/0003 and a measured .opt. mupen64plus-next (GLES3) is now
# possible on this GPU and is the first thing to evaluate after bring-up.
BR2_PACKAGE_LIBRETRO_PARALLELN64=y
# GBA: gpSP's dynarec, not mGBA's interpreter. Measured 3-5x on Cortex-A7.
BR2_PACKAGE_LIBRETRO_GPSP=y
#
# New on the Zero3, made possible by the Mali-G31's GLES3 (the reference's
# Mali-400 was GLES2 only). Both use hardware rendering through RetroArch's
# GLES3 context (retroarch.mk: --enable-opengles3) and an ARM64 dynarec.
# PSP: PPSSPP, upstream v1.20.4. Needs its assets in system/PPSSPP, which
# S46ppsspp copies onto the card.
BR2_PACKAGE_LIBRETRO_PPSSPP=y
# Dreamcast / NAOMI / Atomiswave: Flycast v2.7. Uses its HLE BIOS unless
# dc_boot.bin + dc_flash.bin are in _system/bios/dc/.
BR2_PACKAGE_LIBRETRO_FLYCAST=y
#
# Known broken in the reference tree, kept here as documentation:
#   PICODRIVE  - submodule git server notaz.gp2x.de unreachable
#   BLUEMSX    - OpenMsxYMF262.cpp compile errors, not fixable with -fcommon
# BR2_PACKAGE_LIBRETRO_PICODRIVE is not set
# BR2_PACKAGE_LIBRETRO_BLUEMSX is not set

# --- Audio --------------------------------------------------------------
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
# alsa-utils installs nothing without its tool sub-options.
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# --- Host communication -------------------------------------------------
# Onboard gigabit Ethernet (bcmgenet) + SSH.
BR2_PACKAGE_DROPBEAR=y

# --- Bluetooth: wireless DualShock 3 ------------------------------------
# Same stack as the reference. The radio is a USB dongle for now; the onboard
# BCM43455 (which has working drivers) comes later. BlueZ's sixaxis plugin
# pairs the pad over USB once, then it connects wirelessly.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_SIXAXIS=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
# Firmware for the common Realtek USB BT dongles (RTL8761B, RTL8821C etc).
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y

# --- Host tools for image assembly --------------------------------------
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_EXFATPROGS=y
# mtools: genimage writes the FAT boot partition with it.
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_RETROOPI_TOOLS=y
