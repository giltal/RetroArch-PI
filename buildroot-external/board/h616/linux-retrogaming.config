# H616/H618 kernel config fragment (Orange Pi Zero3, KickPi K2B), applied on top of
# arch/arm64/configs/defconfig, after board/common/linux-retrogaming.config
# (display/sound core, input, Bluetooth, filesystems: everything that is not
# Allwinner-specific) and before the board's own linux.config.
#
# arm64 defconfig already enables ARCH_SUNXI, MMC_SUNXI, SUN8I_THERMAL,
# CPUFREQ_DT, PHY_SUN4I_USB, NVMEM_SUNXI_SID and RTC_DRV_SUN6I. It builds most
# of the display, GPU and audio stack as modules. We pull that stack in as =y:
#
#   - the boot console appears on HDMI with no module loading involved. On the
#     reference board that was the cheapest "is the display alive" signal we
#     had, and it still is.
#   - no firmware is involved anywhere in this path, so there is none of the
#     "built-in probes before rootfs mounts" trouble that forced brcmfmac to
#     be a module on the A33 (see the reference DevelopmentLog).
#
# Values for the Allwinner-specific symbols follow Armbian's
# config/kernel/linux-sunxi64-current.config, which ships on this board.

# --- Display: DE33 mixer -> TCON-TV -> DW-HDMI --------------------------
# The H616 support for these comes from patches/linux/0001-0042 (Armbian's
# copy of the sun4i-drm refactor). Mainline 6.18 has none of the H616 nodes.
# CONFIG_DRM and the framebuffer console are in board/common.
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_SUN50I_PLANES=y
CONFIG_DRM_DW_HDMI=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
# DSI and the old sun4i HDMI block do not exist on the H618.
# CONFIG_DRM_SUN6I_DSI is not set

# --- GPU: Mali-G31 MP2 (Bifrost) via panfrost ---------------------------
# Render-only, like lima was on the A33: it registers its own DRM node with no
# CRTCs or connectors, and Mesa scans out through sun4i-drm via kmsro. The
# launcher and RetroArch patch 0005 already scan /dev/dri/card* for the node
# that owns a display, so which of them gets card0 does not matter.
CONFIG_DRM_PANFROST=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
# The GPU's power domain: the gpu node has power-domains = <&prcm_ppu 2>,
# served by "allwinner,sun50i-h616-prcm-ppu". arm64 defconfig leaves this OFF
# (it only has the D1 PPU, SUN20I_PPU). Without it the domain stays
# "dormant", panfrost waits and then fails with "deferred probe timeout ...
# error -110" at ~16 s, no render node appears, and RetroArch dies on
# "[KMS]: Couldn't create GBM device". That was the first Zero3 boot of build #1.
CONFIG_SUN50I_H6_PRCM_PPU=y

# --- Audio --------------------------------------------------------------
# HDMI audio goes through the H616 "audio hub". Mainline has no driver for it.
# sound/soc/sunxi_v2 comes from patches/linux/0043, with the clock fix in 0044.
# AAUDIO is the analog LINEOUT on the 13-pin header; it selects
# SND_SUN4I_CODEC, which carries the H616 codec in mainline.
# SOUND/SND/SND_SOC themselves are in board/common (they are =m in arm64
# defconfig, and everything below would silently follow them).
CONFIG_SND_SOC_SUNXI_AHUB=y
CONFIG_SND_SOC_SUNXI_AAUDIO=y
CONFIG_SND_SUN4I_I2S=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_DMA_SUN6I=y
CONFIG_SUN50I_IOMMU=y

# --- Power / thermal ----------------------------------------------------
# The Zero3 has an AXP313a PMIC. It supplies dcdc1 to the GPU (mali-supply)
# and aldo1 to the HDMI PHY (hvcc-supply), so it must be up before either probes.
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y
CONFIG_SUN8I_THERMAL=y
CONFIG_CPU_THERMAL=y

# --- Ethernet: the dev link ---------------------------------------------
# H616/H618 boards have gigabit Ethernet on EMAC0 with an external PHY. That
# replaces the reference board's USB-Ethernet dongle as the ssh/scp
# iteration channel. The PHY driver is board-specific: see the board's own
# linux.config (Zero3: Motorcomm YT8531, K2B V2.2: Maxio MAE0621A).
# USB-Ethernet dongles as a fallback: board/common.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
CONFIG_MDIO_SUN4I=y

# --- USB ---------------------------------------------------------------
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
