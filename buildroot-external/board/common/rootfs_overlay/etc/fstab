# <file system>	<mount pt>	<type>	<options>	<dump>	<pass>
# noatime here only documents it: the root is remounted by inittab, whose line
# board/common/post-build.sh makes "remount,rw,noatime" (BusyBox's remount does
# not read the options from this file).
/dev/root	/		ext2	rw,noatime,noauto	0	1
proc		/proc		proc	defaults	0	0
devpts		/dev/pts	devpts	defaults,gid=5,mode=620,ptmxmode=0666	0	0
tmpfs		/dev/shm	tmpfs	mode=1777	0	0
tmpfs		/tmp		tmpfs	mode=1777	0	0
tmpfs		/run		tmpfs	mode=0755,nosuid,nodev	0	0
sysfs		/sys		sysfs	defaults	0	0

# ROM partition (SD card p2): exFAT as built (post-image.sh), or FAT32 if reformatted. The launcher hardcodes /opt/roms and scans
# one subdirectory per system; see launcher/launcher.c. Built empty by
# board/common/post-image.sh; /etc/init.d/S46card creates the folders on first boot.
#
# mmcblk0 must be the SD card. With more than one MMC host enabled, numbering
# follows probe order unless the board's DT pins it with mmc aliases (K2B: SD +
# SDIO Wi-Fi, kernel patch 0063). The Zero3 enables only the SD slot. The
# reference board had SD and SDIO racing, and this entry pointed at the wrong
# device until aliases pinned it.
#
# umask=0022 rather than the vfat default so ROMs are world-readable; FAT has no
# permission bits of its own, so they come from the mount options.
#
# Type "auto", so either filesystem mounts. The options must therefore be ones
# BOTH vfat and exfat accept: a vfat-only option such as shortname= or utf8 makes
# an exFAT mount fail outright, and the launcher then shows no games. Neither
# was needed: FAT names are UTF-8 by kernel default (CONFIG_FAT_DEFAULT_UTF8), and
# shortname=mixed is vfat's own default. post-build.sh checks this line.
/dev/mmcblk0p2	/opt/roms	auto	rw,noatime,umask=0022	0	0
