# Kernel config fragment shared by every board: what the console needs from
# the kernel whatever the SoC. Applied first, on top of the family's base
# defconfig (arm64 defconfig for the H616 boards, bcm2711_defconfig for the
# Pi 4); the family fragment (board/<family>/linux-retrogaming.config) and the
# board's own linux.config come after it and may override a line.
#
# Moved here from board/h616/linux-retrogaming.config when the Pi 4 was added.
# The H616 boards' effective set of lines did not change.

# --- Display ------------------------------------------------------------
# DRM built in, plus fbdev emulation + framebuffer console: kernel messages on
# the TV before userspace, with no module loading involved. On the reference
# board that was the cheapest "is the display alive" signal we had, and it
# still is. The display and GPU drivers themselves are per family.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# --- Audio --------------------------------------------------------------
# CONFIG_SOUND is the parent of all of ALSA, and arm64 defconfig sets it to
# =m. A tristate cannot be built in under a modular parent, so without this
# line EVERY =y below silently became =m (build #1). post-build.sh now fails
# the build when a line in this fragment does not survive into .config.
# HDMI audio is ASoC on both families; the SoC drivers are per family.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_USB_AUDIO=y

# --- Ethernet fallback: USB dongles -------------------------------------
# The onboard Ethernet is per family. USB-Ethernet dongles still work as a
# fallback. Carried over from the reference, where the r8152 was the only way in.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y

# --- Input: DualShock 3, wired and over Bluetooth -----------------------
# Carried over from the reference. See its linux-retrogaming.config for the
# full story; the short version:
#   HIDRAW - the BlueZ sixaxis plugin pairs a DS3 through /dev/hidraw*
#   UHID   - BlueZ 5 creates BT HID input devices through /dev/uhid, not HIDP.
#            Without it the pad "connects" and no js0/event node appears.
CONFIG_USB_HID=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_FF_MEMLESS=y
# Synthetic input for automated on-target testing (tools/inject-input.c).
CONFIG_INPUT_UINPUT=y

# --- Bluetooth ----------------------------------------------------------
# Neither H616 board's onboard radio has a mainline driver, so Bluetooth there
# means a USB dongle; the Pi 4 starts the same way. btusb covers the common
# CSR/Realtek/Broadcom/Intel sticks.
# BT cannot be built in while RFKILL is a module (arm64 defconfig: =m), so BT
# silently came out =m in build #1. Same trap as CONFIG_SOUND above.
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y
# btusb MUST be a module. Realtek dongles need firmware (rtl_bt/*), and
# built-in btusb probes the USB device before the rootfs is mounted, so the
# firmware request fails. The reference hit exactly this with brcmfmac and
# hci_bcm. As a module, udev loads it after /lib/firmware exists.
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_CMAC=y

# --- Filesystems --------------------------------------------------------
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# exFAT for the ROM partition, so a card reformatted in Windows as exFAT still
# works. /etc/fstab mounts it as "auto" for this. Names are UTF-8 by default.
# board/common/patches/linux/0001 plugs its directory readahead.
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
# Kept OFF on purpose: fstab's "auto" tries every filesystem the kernel lists,
# and the msdos driver would accept a FAT32 card, showing only 8.3 short names.
# CONFIG_MSDOS_FS is not set
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
