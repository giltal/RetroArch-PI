# KickPi K2B kernel config, applied after board/h616/linux-retrogaming.config.

# Ethernet PHY. The K2B V2.2 (our board, DDR3) has a Maxio MAE0621A (patch
# 0062). Without its driver the PHY never drives the RGMII RX clock and the
# EMAC probe fails with "EMAC reset timeout": no eth0 at all. The V1 has an
# RTL8211F (already =y in arm64 defconfig, listed so the check covers it).
CONFIG_MAXIO_PHY=y
CONFIG_REALTEK_PHY=y

# Power button: a gpio-keys-polled KEY_POWER on PC2. arm64 defconfig builds
# the driver as a module; built in, the input device exists before volumed
# starts, and volumed turns KEY_POWER into a clean shutdown.
CONFIG_KEYBOARD_GPIO_POLLED=y
