# BCM2711 kernel config fragment (Raspberry Pi 4), applied on top of the
# Raspberry Pi kernel's arch/arm64/configs/bcm2711_defconfig, after
# board/common/linux-retrogaming.config.
#
# Same policy as the H616 family: everything on the path to the menu is built
# in (=y), so the boot console reaches HDMI and the launcher finds its display,
# GPU, sound card, network and USB with no module loading in the critical path.
# bcm2711_defconfig builds most of these as modules. post-build.sh fails the
# build if a line here does not survive into the kernel's .config.

# --- Display + GPU: vc4 (scanout, HDMI) and v3d (render) ----------------
# Like panfrost + sun4i-drm on the H616: v3d is render-only, vc4 owns the
# CRTCs and connectors, and Mesa pairs them (kmsro). The launcher and
# RetroArch pick the DRM node that has connectors. The firmware side is
# config.txt's dtoverlay=vc4-kms-v3d-pi4 (board/rpi4/config.txt).
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
# HDMI audio is part of vc4 (vc4_hdmi registers an ASoC card per HDMI port);
# SND_SOC is in board/common.
# The HDMI ports' DDC (EDID) buses are BCM2711 "hdmi-i2c" controllers, driven
# by i2c-brcmstb; vc4_hdmi defers until its ddc adapter exists, and with it the
# whole vc4 device. bcm2711_defconfig has it =m, and on the first boot (with
# no module loading, see below) vc4 never bound: no display node, no HDMI, no
# sound card, launcher "no KMS-capable device". insmod of the module brought
# HDMI up at once.
CONFIG_I2C_BRCMSTB=y
# Same trap for a DPI panel (the GPi Case 2's LCD, vc4-kms-dpi-generic): vc4's
# DPI waits for its panel-dpi, and with panel-simple =m the boot never got as
# far as init (no init script ran, both screens black, the SoC hot; the same
# overlay loaded at runtime bound at once). Built in, it is there before vc4.
# It depends on the backlight class, =m in bcm2711_defconfig: without that line
# Kconfig silently kept panel-simple =m.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_SIMPLE=y

# --- Boot time: debug and unused drivers off ----------------------------
# Measured with initcall_debug on the Pi 4 (2026-10-18): init_kprobe_trace
# alone took 393 ms of the 2.9 s to /sbin/init. Tracing is a debug feature
# bcm2711_defconfig enables; the console does not need it.
# CONFIG_KPROBE_EVENTS is not set
# CONFIG_FTRACE is not set
# Camera, codec, ISP, HEVC decoder and the VideoCore's analog audio: never used
# here (no camera, RetroArch decodes nothing, audio is HDMI through vc4), but
# udev loaded all of them at every boot, alongside rcS.
# CONFIG_VIDEO_BCM2835 is not set
# CONFIG_VIDEO_BCM2835_UNICAM is not set
# CONFIG_VIDEO_CODEC_BCM2835 is not set
# CONFIG_VIDEO_ISP_BCM2835 is not set
# CONFIG_VIDEO_RPI_HEVC_DEC is not set
# CONFIG_BCM2835_VCHIQ_MMAL is not set
# CONFIG_BCM_VC_SM_CMA is not set
# CONFIG_SND_BCM2835 is not set

# --- Modules: uncompressed ----------------------------------------------
# bcm2711_defconfig compresses every module (.ko.xz). Neither the build's
# depmod (host-kmod without xz) nor BusyBox modprobe reads xz, so the first
# image shipped an EMPTY modules.dep and udev loaded nothing at all. Plain .ko
# as on the H616 boards: nothing to decompress at load time either.
# CONFIG_MODULE_COMPRESS is not set

# --- Firmware interface, clocks, cpufreq, thermal -----------------------
# The VideoCore firmware owns the clocks and the VL805 USB controller's reset;
# the kernel talks to it through the mailbox.
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_ARM_RASPBERRYPI_CPUFREQ=y
CONFIG_BCM2711_THERMAL=y
CONFIG_CPU_THERMAL=y

# --- Storage: the SD slot (emmc2) ---------------------------------------
CONFIG_MMC_SDHCI_IPROC=y

# --- Ethernet: the dev link ---------------------------------------------
# bcmgenet with a Broadcom BCM54213PE PHY behind the UniMAC MDIO bus.
CONFIG_BCMGENET=y
CONFIG_BROADCOM_PHY=y
CONFIG_MDIO_BCM_UNIMAC=y

# --- USB: VL805 xHCI on PCIe --------------------------------------------
# All four USB-A ports are behind the VL805, a PCIe xHCI controller. Its
# firmware is loaded by the VideoCore after a reset requested through
# RESET_RASPBERRYPI; without that the controller never comes up.
CONFIG_PCIE_BRCMSTB=y
CONFIG_RESET_RASPBERRYPI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y

# --- Arcade case: GPIO3 power button and SPI status LCD -----------------
# config.txt's gpio-shutdown and mipi-dbi-spi overlays. Modules on purpose
# (bcm2711_defconfig already has them =m): udev loads them from the overlays'
# compatibles, and panel-mipi-dbi probing after the built-in vc4/v3d keeps the
# LCD the last DRM card, so nothing that takes "the first KMS device" picks it.
# Its init sequence is a file in /lib/firmware, which a built-in driver could
# not read before the root filesystem is mounted.
CONFIG_KEYBOARD_GPIO=m
CONFIG_SPI_BCM2835=m
CONFIG_DRM_PANEL_MIPI_DBI=m
CONFIG_BACKLIGHT_GPIO=m
